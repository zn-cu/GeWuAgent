# ============================================================
# 格物致知（Gewu）环境变量模板
# 用法：复制为 .env 后按需填写
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# 标了 <必填> 的必须自己申请，其余保持默认即可跑通（默认值对应 docker-compose.yml 起的服务）
# ============================================================

# ---------------- 大模型（阿里云百炼 DashScope，OpenAI 兼容接口）----------------
# 申请地址：https://bailian.console.aliyun.com/  → API-KEY
OPENAI_API_KEY=<必填：百炼 API Key>
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen3.8-flash
# 视觉理解模型（识别手册里的图片）
VL_MODEL=qwen3.8-flash
LLM_DEFAULT_TEMPERATURE=0.1

# ---------------- 联网搜索（DashScope MCP）----------------
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse
MCP_DASHSCOPE_BASE_URL_STREAMABLE=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
# 专用 Key；留空则回退复用上面的 OPENAI_API_KEY
MCP_DASHSCOPE_API_KEY=

# ---------------- PDF 解析（MinerU）----------------
# 申请地址：https://mineru.net/ → API Token
MINERU_API_TOKEN=<必填：MinerU Token>
MINERU_BASE_URL=https://mineru.net/api/v4
# 以下三个由 modelscope / huggingface / mineru 库直接读取，不经过应用代码
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
HF_HOME=D:/ai_models/huggingface_cache

# ---------------- Embedding（BGE-M3：稠密 + 稀疏）----------------
BGE_M3=BAAI/bge-m3
# 本地权重路径；留空则从远端拉取
BGE_M3_PATH=D:/ai_models/modelscope_cache/models/models/BAAI--bge-m3/snapshots/master
# cpu / cuda:0
BGE_DEVICE=cpu
# GPU 上通常开 1，CPU 上必须 0
BGE_FP16=0

# ---------------- 重排序（BGE-Reranker-Large）----------------
BGE_RERANKER_LARGE=D:/ai_models/modelscope_cache/models/rerank/models/BAAI--bge-reranker-large/snapshots/master
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# ---------------- Milvus ----------------
MILVUS_URL=http://127.0.0.1:19530
# 切片集合
CHUNKS_COLLECTION=kb_chunks
# 主体名向量集合
ITEM_NAME_COLLECTION=kb_item_names
# 预留：实体名集合
ENTITY_NAME_COLLECTION=kb_graph_entity_names

# ---------------- MongoDB（对话历史）----------------
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=kb002

# ---------------- MinIO（手册图片 / 原始文件）----------------
# 默认值对应 docker-compose.yml 里的 minio 服务（宿主端口 9002）
MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
# 原始 PDF 在桶里的目录前缀
MINIO_PDF_DIR=pdf_files
MINIO_SECURE=False

# ---------------- 日志 ----------------
LOG_CONSOLE_ENABLE=True
# 调成 DEBUG 可看到 SSE 连接与队列细节
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
# 保留天数
LOG_FILE_RETENTION=7 days
